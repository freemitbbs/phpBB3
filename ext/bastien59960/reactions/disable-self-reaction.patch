From: patch
Subject: Disable users from reacting to their own posts/comments

This patch makes 4 changes:
1. ajax.php: Add is_own_post() method and check it before allowing add/remove
2. listener.php: Pass S_IS_OWN_POST flag to the template for each post
3. viewtopic_body_postrow_content_after.html: Render readonly mode for own posts
4. reactions.js: Handle own_post error from server without breaking the session
5. language/en/common.php: Add REACTION_OWN_POST language key

NOTE: You must also add the REACTION_OWN_POST key to other language files
      (fr, de, es, it) with appropriate translations.

---
 controller/ajax.php                                              | 29 ++++++++++++++
 event/listener.php                                               |  5 +++
 language/en/common.php                                           |  1 +
 styles/prosilver/template/event/viewtopic_body_postrow_content_after.html | 12 +++++-
 styles/prosilver/template/js/reactions.js                        |  8 ++++
 5 files changed, 54 insertions(+), 1 deletion(-)

diff --git a/controller/ajax.php b/controller/ajax.php
--- a/controller/ajax.php
+++ b/controller/ajax.php
@@ -343,6 +343,17 @@
             // Pour les autres actions, on vérifie si l'utilisateur peut interagir avec le post.
             if ($action !== 'sync')
             {
+                // Interdire de réagir à ses propres messages
+                if (in_array($action, ['add', 'remove'], true) && $this->is_own_post($post_id)) {
+                    return new JsonResponse([
+                        'success'  => false,
+                        'error'    => $this->language->lang('REACTION_OWN_POST'),
+                        'own_post' => true,
+                        'rid'      => $rid,
+                    ], 400);
+                }
+
                 if (!$this->can_react_to_post($post_id)) {
                     return new JsonResponse([
                         'success' => false,
@@ -875,6 +886,24 @@
         return true;
     }

+    /**
+     * Vérifie si le message appartient à l'utilisateur courant
+     *
+     * @param int $post_id ID du message
+     * @return bool true si l'utilisateur est l'auteur du message
+     */
+    private function is_own_post($post_id)
+    {
+        $sql = 'SELECT poster_id FROM ' . $this->posts_table . ' WHERE post_id = ' . (int) $post_id;
+        $result = $this->db->sql_query($sql);
+        $row = $this->db->sql_fetchrow($result);
+        $this->db->sql_freeresult($result);
+
+        if (!$row) {
+            return false;
+        }
+
+        return (int) $row['poster_id'] === (int) $this->user->data['user_id'];
+    }
+
     // =============================================================================
     // MÉTHODES UTILITAIRES
     // =============================================================================
diff --git a/event/listener.php b/event/listener.php
--- a/event/listener.php
+++ b/event/listener.php
