         $reactions_by_db = $this->get_post_reactions($post_id);
         $user_reactions = $this->get_user_reactions($post_id, (int) $this->user->data['user_id']);

+        // Déterminer si le message appartient à l'utilisateur courant
+        $poster_id = isset($row['poster_id']) ? (int) $row['poster_id'] : 0;
+        $is_own_post = ($poster_id === (int) $this->user->data['user_id']);
+
         $visible_reactions = [];
         foreach ($reactions_by_db as $emoji => $count) {
             if ((int) $count > 0) {
@@ -228,6 +233,7 @@
         $post_row = array_merge($post_row, [
             'S_REACTIONS_ENABLED' => true,
+            'S_IS_OWN_POST'      => $is_own_post,
             'post_reactions'      => $visible_reactions,
         ]);

